
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MY BLACK APP</title>

<style>
* { box-sizing: border-box; }

body {
    margin: 0;
    background: #050505;
    color: white;
    font-family: Arial, sans-serif;
}

.app {
    max-width: 430px;
    min-height: 100vh;
    margin: auto;
    padding: 30px 22px;
}

.clock {
    text-align: right;
    color: #888;
    font-size: 13px;
}

#clock {
    font-size: 23px;
    font-weight: bold;
    color: white;
}

header {
    text-align: center;
    padding: 25px 0;
}

h1 {
    letter-spacing: 4px;
    font-size: 29px;
}

.subtitle { color: #777; }

.screen { display: none; }
.screen.active { display: block; }

button {
    width: 100%;
    padding: 19px;
    margin: 9px 0;
    border: 1px solid #333;
    border-radius: 14px;
    background: #151515;
    color: white;
    font-size: 16px;
    transition: 0.2s;
}

button:active {
    background: #444;
    transform: scale(0.97);
}

.panel {
    background: #111;
    border: 1px solid #292929;
    border-radius: 18px;
    padding: 22px;
    margin: 15px 0;
}

h2 { font-size: 23px; }

footer {
    text-align: center;
    color: #555;
    margin-top: 45px;
    font-size: 12px;
}
</style>
</head>

<body>
<div class="app">

<div class="clock">
    <div id="clock">00:00:00</div>
    <div id="date"></div>
</div>

<header>
    <h1>MY BLACK APP</h1>
    <p class="subtitle">ТВОЁ ПРОСТРАНСТВО</p>
</header>

<section id="home" class="screen active">
    <div class="panel">
        <h2>Главное меню</h2>
        <p style="color:#888">Добро пожаловать!</p>
    </div>

    <button onclick="show('profile')">👤 МОЙ ПРОФИЛЬ</button>
    <button onclick="show('settings')">⚙️ НАСТРОЙКИ</button>
    <button onclick="show('about')">ℹ️ О ПРИЛОЖЕНИИ</button>
</section>

<section id="profile" class="screen">
    <div class="panel">
        <h2>Мой профиль</h2>
        <p>Пользователь MY BLACK APP</p>
        <p style="color:#777">Версия 1.1</p>
    </div>
    <button onclick="show('home')">← НАЗАД</button>
</section>

<section id="settings" class="screen">
    <div class="panel">
        <h2>Настройки</h2>
        <p>Тема: Чёрная 🖤</p>
        <p>Язык: Русский</p>
        <p>Версия: 1.1</p>
    </div>
    <button onclick="show('home')">← НАЗАД</button>
</section>

<section id="about" class="screen">
    <div class="panel">
        <h2>О приложении</h2>
        <p>MY BLACK APP</p>
        <p>Наш собственный проект!</p>
    </div>
    <button onclick="show('home')">← НАЗАД</button>
</section>

<footer>MY BLACK APP © 2026</footer>

</div>

<script>
function show(id) {
    document.querySelectorAll('.screen').forEach(screen => {
        screen.classList.remove('active');
    });

    document.getElementById(id).classList.add('active');
}

function updateClock() {
    const now = new Date();

    document.getElementById("clock").textContent =
        now.toLocaleTimeString("ru-RU");

    document.getElementById("date").textContent =
        now.toLocaleDateString("ru-RU");
}

updateClock();
setInterval(updateClock, 1000);
</script>

</body>
</html>
python -m http.server 8000

